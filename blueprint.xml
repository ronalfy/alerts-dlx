		<title><![CDATA[Welcome to Singular Alerts]]></title>
		<link>https://singularalerts.local/</link>
		<pubDate>Sat, 17 Oct 2026 23:56:18 +0000</pubDate>
		<dc:creator><![CDATA[ronalfy]]></dc:creator>
		<guid isPermaLink="false">https://singularalerts.local/?page_id=12</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Intro","categories":["about"]},"align":"full","className":"alignfull","style":{"spacing":{"margin":{"top":"0","bottom":"0"}}},"layout":{"type":"constrained","justifyContent":"center"}} -->
<div class="wp-block-group alignfull" style="margin-top:0;margin-bottom:0"><!-- wp:spacer {"height":"var:preset|spacing|20"} -->
<div style="height:var(--wp--preset--spacing--20)" aria-hidden="true" class="wp-block-spacer"></div>
<!-- /wp:spacer -->

<!-- wp:group {"metadata":{"name":"Contents"},"align":"wide","layout":{"type":"default"}} -->
<div class="wp-block-group alignwide"><!-- wp:columns {"verticalAlignment":"top","align":"wide","className":"is-style-section-1","style":{"spacing":{"blockGap":{"top":"var:preset|spacing|40"}}}} -->
<div class="wp-block-columns alignwide are-vertically-aligned-top is-style-section-1"><!-- wp:column {"verticalAlignment":"top","width":"","layout":{"type":"constrained","justifyContent":"left","contentSize":"450px"}} -->
<div class="wp-block-column is-vertically-aligned-top"><!-- wp:heading -->
<h2 class="wp-block-heading">Uncover the possibilities of Singular Alerts. One block and shortcode cover the entire feature set.</h2>
<!-- /wp:heading --></div>
<!-- /wp:column -->

<!-- wp:column {"verticalAlignment":"top","width":"60%"} -->
<div class="wp-block-column is-vertically-aligned-top" style="flex-basis:60%"><!-- wp:paragraph -->
<p>Add an alert, set a global style or preset, and keep working on your tasks or writing.</p>
<!-- /wp:paragraph -->

<!-- wp:mediaron/alerts-dlx-alert {"alertType":"warning","alertTitle":"Warning: Creating Alerts Can Be Addictive","buttonEnabled":true,"closeButtonEnabled":true,"closeButtonExpiration":3600,"buttonText":"View on WordPress.org","buttonUrl":"https://wordpress.org/plugins/alerts-dlx/","buttonHasUrl":true,"buttonTarget":true,"buttonRelNoFollow":true,"uniqueId":"alerts-dlx-24382caf","globalStyleId":14,"className":"is-style-warning"} -->
<!-- wp:paragraph {"placeholder":""} -->
<p>With beautiful and versatile alerts, you can be sure your use case is covered. And if it's not, you can request it as a feature!</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"placeholder":""} -->
<p>Psst, this is a global alert style with a dismiss action.</p>
<!-- /wp:paragraph -->
<!-- /wp:mediaron/alerts-dlx-alert --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:spacer {"height":"var:preset|spacing|20"} -->
<div style="height:var(--wp--preset--spacing--20)" aria-hidden="true" class="wp-block-spacer"></div>
<!-- /wp:spacer --></div>
<!-- /wp:group -->

<!-- wp:spacer {"height":"var:preset|spacing|20"} -->
<div style="height:var(--wp--preset--spacing--20)" aria-hidden="true" class="wp-block-spacer"></div>
<!-- /wp:spacer --></div>
<!-- /wp:group -->

<!-- wp:heading -->
<h2 class="wp-block-heading">One Alert Block and Shortcode, Limitless Possibilities</h2>
<!-- /wp:heading -->

