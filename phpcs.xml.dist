<?xml version="1.0"?>
<ruleset name="AlertsDLX">
	<description>PHP_CodeSniffer ruleset for AlertsDLX.</description>

	<file>alerts-dlx.php</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="text_domain" value="alerts-dlx"/>
	<config name="minimum_supported_wp_version" value="6.0"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.InvalidTemplateTagFileName"/>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>
</ruleset>
