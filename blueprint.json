{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.0",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/",
  "steps": [
    {
      "step": "login",
      "username": "admin"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfive"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "alerts-dlx"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wp-plugin-info-card"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php';$posts = get_posts(array('posts_per_page' => 100,'post_type'   => array( 'post', 'page' ),'post_status' => 'any'));foreach ( $posts as $post ) {wp_delete_post( $post->ID, true );}"
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/ronalfy/alerts-dlx/main/blueprint.xml"
      },
      "authorsMap": {
        "ronalfy": "admin"
      },
      "defaultAuthorUsername": "admin"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/",
        "blogname": "Singular Alerts Demo"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php';$page = get_page_by_path( 'front-page', OBJECT, 'page' );update_option( 'page_on_front', (int) $page->ID );update_option( 'show_on_front', 'page' );"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; update_option( 'alerts_dlx', maybe_unserialize( 'a:9:{s:14:\"headline_style\";s:2:\"h2\";s:23:\"headline_custom_classes\";s:0:\"\";s:19:\"headline_force_size\";b:1;s:10:\"debug_mode\";b:0;s:14:\"margin_spacing\";s:8:\"spacious\";s:21:\"margin_spacing_target\";s:4:\"both\";s:14:\"override_fonts\";b:0;s:20:\"font_family_override\";s:0:\"\";s:15:\"options_version\";s:5:\"1.0.0\";}' ) ); ?>"
    }
  ]
}
