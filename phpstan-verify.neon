includes:
    - tools/phpstan/vendor/szepeviktor/phpstan-wordpress/extension.neon
    - tools/phpstan/vendor/spaze/phpstan-disallowed-calls/extension.neon
    - phpstan-security.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - alerts-dlx.php
        - php
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: true

    dynamicConstantNames:
        - ALERTS_DLX_VERSION
        - ALERTS_DLX_FILE
