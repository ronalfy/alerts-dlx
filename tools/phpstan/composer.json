{
  "name": "dlxplugins/alerts-dlx-phpstan",
  "description": "PHPStan tooling for AlertsDLX",
  "type": "project",
  "license": "GPL",
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "spaze/phpstan-disallowed-calls": "^4.0"
  },
  "config": {
    "platform": {
      "php": "8.0"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse -c ../../phpstan.neon.dist --no-progress --memory-limit=1G"
  }
}
